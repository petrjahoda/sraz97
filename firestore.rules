rules_version = '2';
// The e-mail below must equal SHARED_ACCOUNT_EMAIL in js/config.js (lowercase).
// Publish: `npx firebase-tools deploy --only firestore:rules`
// or paste into Firebase console → Firestore Database → Rules → Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    function isClass() {
      return request.auth != null
        && request.auth.token.email == 'sraz97@example.com';
    }

    match /people/{personId} {
      function validPerson() {
        return request.resource.data.keys().hasOnly(['name', 'maiden', 'gender', 'votes', 'createdAt', 'updatedAt'])
          && request.resource.data.name is string
          && request.resource.data.name.size() >= 2
          && request.resource.data.name.size() <= 80
          && request.resource.data.maiden is string
          && request.resource.data.maiden.size() <= 60
          && request.resource.data.gender in ['f', 'm']
          && request.resource.data.votes is map
          && request.resource.data.votes.size() <= 92;
      }
      allow read: if isClass();
      allow create: if isClass() && validPerson();
      // createdAt never changes, so creating a person again over an existing
      // one (which would wipe their votes) is refused.
      allow update: if isClass() && validPerson()
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;
    }

    match /log/{entryId} {
      allow read: if isClass();
      allow create: if isClass()
        && request.resource.data.keys().hasOnly(['personId', 'name', 'gender', 'text', 'chips', 'at'])
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 200
        && request.resource.data.at == request.time;
      allow update, delete: if false;
    }
  }
}
